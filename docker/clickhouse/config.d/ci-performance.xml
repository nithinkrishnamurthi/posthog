<clickhouse>
    <!-- CI Performance: Use built-in Keeper instead of external ZooKeeper.
         Eliminates network hop for every ReplicatedMergeTree operation. -->
    <keeper_server>
        <tcp_port>9181</tcp_port>
        <server_id>1</server_id>
        <log_storage_path>/var/lib/clickhouse/coordination/log</log_storage_path>
        <snapshot_storage_path>/var/lib/clickhouse/coordination/snapshots</snapshot_storage_path>
        <coordination_settings>
            <operation_timeout_ms>10000</operation_timeout_ms>
            <session_timeout_ms>30000</session_timeout_ms>
            <raft_logs_level>warning</raft_logs_level>
        </coordination_settings>
        <raft_configuration>
            <server>
                <id>1</id>
                <hostname>localhost</hostname>
                <port>9234</port>
            </server>
        </raft_configuration>
    </keeper_server>

    <!-- Point ZooKeeper config to built-in Keeper (overrides config.xml) -->
    <zookeeper replace="replace">
        <node>
            <host>localhost</host>
            <port>9181</port>
        </node>
    </zookeeper>

    <!-- Disable background merges — tests don't need optimized storage layout -->
    <merge_tree>
        <max_bytes_to_merge_at_max_space_in_pool>0</max_bytes_to_merge_at_max_space_in_pool>
        <number_of_free_entries_in_pool_to_execute_mutation>0</number_of_free_entries_in_pool_to_execute_mutation>
    </merge_tree>
    <background_pool_size>1</background_pool_size>

    <!-- Disable system logs to reduce I/O -->
    <query_log remove="remove"/>
    <query_thread_log remove="remove"/>
    <query_views_log remove="remove"/>
    <text_log remove="remove"/>
    <metric_log remove="remove"/>
    <asynchronous_metric_log remove="remove"/>
    <trace_log remove="remove"/>
    <session_log remove="remove"/>
    <opentelemetry_span_log remove="remove"/>
    <backup_log remove="remove"/>
    <crash_log remove="remove"/>

    <!-- Disable distributed_ddl — single node doesn't need DDL queue via Keeper -->
    <distributed_ddl>
        <path></path>
    </distributed_ddl>
</clickhouse>
